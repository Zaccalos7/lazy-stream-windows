@page "/orbis/countdown"
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@T.Language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@T["upcomingLive"]</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/countdown.css" />
    <script>
        (function() {
            var theme = localStorage.getItem('orbis-theme') || 'dark';
            if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
    <script src="/js/site.js" defer></script>
</head>
<body>
    <div class="countdown-fullscreen">
        <h1>@T["upcomingLive"]</h1>
        <div class="countdown" data-countdown="5" data-href="/orbis/mainLive?liveStatus=LIVE" aria-live="polite">5</div>
        <img src="/img/donnoleCinema.png" alt="@T["noImage"]" />
    </div>
</body>
</html>
