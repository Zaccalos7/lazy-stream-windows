@page "/orbis/mainLayout"
@model MainLayoutModel
@{
    ViewData["Title"] = T["layouts"];
}
@section Styles {
    
    <link rel="stylesheet" href="/css/composer.css" />
}
<div class="page-header">
    <div>
        <h1>@T["layouts"]</h1>
        <p class="subtitle">@T["layoutsDescription"]</p>
    </div>
</div>

<partial name="_SceneComposer" model="new SceneComposerModel(Model.Edit, Layout: true)" />
