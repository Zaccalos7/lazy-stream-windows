@page "/orbis/mainLive"
@model MainLiveModel
@{
    ViewData["Title"] = T["liveManagement"];
    var statuses = new[] { LiveStatus.Live, LiveStatus.Offline, LiveStatus.Ended, LiveStatus.Error, LiveStatus.Stopped };
    var cancelLink = Url.Page("/MainLive", new { Model.LiveStatus, Model.ChannelName, p = Model.PageIndex });
    var canStart = Model.ActiveSettings.Count > 0 && Model.ActiveConfigurations.Count > 0;
}
<div class="page-header">
    <div>
        <h1>@T["liveManagement"]</h1>
        <p class="subtitle">@T["liveManagementDescription"]</p>
    </div>
    <div class="actions">
        <a class="btn" href="/orbis/mainLiveHistory"><i class="icon">&#xE81C;</i>@T["liveHistory"]</a>
        @if (Model.Locked.Count > 0)
        {
            <button class="btn" commandfor="unlock-dialog" command="show-modal"><i class="icon">&#xE785;</i>@T["unLockVideo"]</button>
        }
        <button class="btn accent" style="font-size: 1.1em; padding: 10px 20px;" commandfor="start-dialog" command="show-modal"><i class="icon">&#xE768;</i>@T["startLiveButton"]</button>
    </div>
</div>

<form method="get" class="toolbar">
    <label class="field">
        <span class="caption">@T["liveStatus"]</span>
        <select class="input" name="liveStatus" onchange="this.form.requestSubmit()">
            <option value="">–</option>
            @foreach (var status in statuses)
            {
                var wire = status.ToWireValue();
                <option value="@wire" selected="@(string.Equals(Model.LiveStatus, wire, StringComparison.OrdinalIgnoreCase))">@T[LiveStatusView.Key(status)]</option>
            }
        </select>
    </label>
    <label class="field">
        <span class="caption">@T["channel"]</span>
        <select class="input" name="channelName" onchange="this.form.requestSubmit()">
            <option value="">–</option>
            @foreach (var channel in Model.Channels)
            {
                <option value="@channel" selected="@(Model.ChannelName == channel)">@channel</option>
            }
        </select>
    </label>
</form>

@* The rows are redone when the server says one of them moved, not every few seconds: the change
   it was drawn from travels with it, so the first push is a real change. *@
<div data-refresh="@Url.Page("/MainLive", "Rows", new { Model.LiveStatus, Model.ChannelName, p = Model.PageIndex })" data-since="@Model.ChangeVersion">
    <partial name="_LiveRows" model="Model" />
</div>

@* Start a new live by composing the scene first. *@
<dialog class="dialog wide" id="start-dialog" open="@(Model.OpenStart ? "" : null)" style="width: 90vw; max-width: 90vw; height: 90vh; padding: 0;">
    <div style="display: flex; justify-content: flex-end; padding: 10px; background: var(--background);">
        <button class="btn subtle icon-only" type="button" commandfor="start-dialog" command="close" title="@T["cancel"]">
            <i class="icon">&#xE711;</i>
        </button>
    </div>
    <iframe src="/orbis/mainPreview?compose=1" style="width: 100%; height: calc(100% - 50px); border: none;"></iframe>
</dialog>

@* Videos left LIVE after a crash, an error or a stop made on the platform. *@
<dialog class="dialog" id="unlock-dialog">
    <div class="dialog-body">
        <h2>@T["unLockVideo"]</h2>
        <p>@T["hereYouCanUnlockVideos"]</p>
        <ul class="muted">
            <li>@T["appClosedUnexpectedly"]</li>
            <li>@T["videoLockedUnexpectedly"]</li>
            <li>@T["liveStreamStopped"]</li>
        </ul>
        @if (Model.Locked.Count == 0)
        {
            <div class="empty">@T["noLockedVideo"]</div>
        }
        @foreach (var channel in Model.Locked)
        {
            <h3 class="section">@T["channel"]: @channel.ChannelName</h3>
            @foreach (var video in channel.VideoPathAndKeyList)
            {
                <div class="row-card">
                    <i class="icon lead">&#xE72E;</i>
                    <span class="grow truncate" title="@video.VideoPath">@video.VideoPath</span>
                    <form method="post" asp-page-handler="Unlock" asp-all-route-data="Model.UnlockRoute(video.VideoKey)">
                        <button class="btn"><i class="icon">&#xE785;</i>@T["unlockVideoButton"]</button>
                    </form>
                </div>
            }
        }
    </div>
    <div class="dialog-footer">
        <button class="btn" commandfor="unlock-dialog" command="close">@T["back"]</button>
    </div>
</dialog>

@if (Model.LinkPkid is { } linkPkid && Model.Form is not null)
{
    <dialog class="dialog wide" data-open>
        <form method="post" asp-page-handler="Link" asp-all-route-data="Model.RowRoute(linkPkid)">
            <div class="dialog-body">
                <h2>@T["connectVideoSetting"]</h2>
                <partial name="_VideoSettingFields" for="Form" />
            </div>
            <div class="dialog-footer">
                <button class="btn accent">@T["save"]</button>
                <a class="btn" href="@cancelLink">@T["cancel"]</a>
            </div>
        </form>
    </dialog>
}
