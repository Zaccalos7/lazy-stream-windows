@page "/orbis/mainLiveHistory"
@model MainLiveHistoryModel
@{
    ViewData["Title"] = T["liveHistory"];
    var page = Model.Videos.Page;
    var pager = new PagerModel(page.Number, page.TotalPages, index => Url.Page("/MainLiveHistory", new { p = index })!);
}
@* Storico Live è una pagina a sé: nel menu c'è già la voce, quindi nessun "indietro" né il
   collegamento a Gestione Live nell'intestazione. *@
<div class="page-header">
    <div>
        <h1>@T["liveHistory"]</h1>
    </div>
    <div class="toolbar">
        @* One form for both buttons: the run button carries runNow, so the picks on screen are the
           ones the cleanup works on. Both land on the InfoBar at the top of the page, like every
           other action of the application. *@
        <form method="post" asp-page-handler="SaveAutoCleanup" class="auto-cleanup-config" style="gap: 24px; display: flex; flex-wrap: wrap; align-items: center;">
            <label class="field toggle-section" style="gap: 8px;">
                <span>@T["autoCleanupEnabled"]</span>
                <label class="toggle" style="gap: 8px;">
                    <input type="checkbox" id="autoCleanupEnabled" name="enabled" value="true" @(Model.AutoCleanupEnabled ? "checked" : "") />
                    <span class="muted">@T["autoCleanupEnabled"]</span>
                </label>
            </label>
            <div id="autoCleanupFields" style="display: @(Model.AutoCleanupEnabled ? "flex" : "none"); gap: 24px; flex-wrap: wrap; align-items: center;">
                <label class="field" style="gap: 8px;">
                    <span>@T["autoCleanupIntervalMonths"]</span>
                    <select id="autoCleanupIntervalMonths" name="intervalMonths" class="input">
                        <option value="1" selected="@(Model.AutoCleanupIntervalMonths == 1)">1 @T["monthAbbrev"]</option>
                        <option value="2" selected="@(Model.AutoCleanupIntervalMonths == 2)">2 @T["monthAbbrev"]</option>
                        <option value="3" selected="@(Model.AutoCleanupIntervalMonths == 3)">3 @T["monthAbbrev"]</option>
                        <option value="6" selected="@(Model.AutoCleanupIntervalMonths == 6)">6 @T["monthAbbrev"]</option>
                        <option value="12" selected="@(Model.AutoCleanupIntervalMonths == 12)">12 @T["monthAbbrev"]</option>
                    </select>
                </label>
                <label class="field" style="gap: 8px;">
                    <span>@T["autoCleanupOlderThanMonths"]</span>
                    @* The value is the number of months the cleanup works on, so a pick that says a
                       day has to send 0 (yesterday), not 1 (a month). *@
                    <select id="autoCleanupOlderThanMonths" name="olderThanMonths" class="input">
                        <option value="0" selected="@(Model.AutoCleanupOlderThanMonths == 0)">@T["olderThanYesterday"]</option>
                        <option value="1" selected="@(Model.AutoCleanupOlderThanMonths == 1)">1 @T["monthAbbrev"]</option>
                        <option value="3" selected="@(Model.AutoCleanupOlderThanMonths == 3)">@T["olderThan3Months"]</option>
                        <option value="6" selected="@(Model.AutoCleanupOlderThanMonths == 6)">@T["olderThan6Months"]</option>
                        <option value="12" selected="@(Model.AutoCleanupOlderThanMonths == 12)">@T["olderThan1Year"]</option>
                        <option value="24" selected="@(Model.AutoCleanupOlderThanMonths == 24)">@T["olderThan2Years"]</option>
                    </select>
                </label>
                <button type="submit" class="btn accent">
                    <i class="icon">&#xE74E;</i> @T["save"]
                </button>
                <button type="submit" name="runNow" value="true" class="btn subtle" title="@T["runCleanupNow"]">
                    <i class="icon">&#xE72C;</i> @T["runCleanupNow"]
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Videos.Content.Count == 0)
{
    <div class="card empty"><i class="icon">&#xE81C;</i>@T["noDataPresent"]</div>
}
else
{
    <div class="live-rows-container history-rows-container">
    <div class="table-wrap-scrollable">
    <div class="table-wrap">
        <table class="list roomy">
            <thead>
            <tr>
                <th>@T["title"]</th>
                <th>@T["liveStatus"]</th>
                <th>@T["channel"]</th>
                <th>@T["platform"]</th>
                <th>@T["path"]</th>
                <th>@T["data"]</th>
                <th>@T["outcome"]</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var video in Model.Videos.Content)
            {
                var history = video.VideoLiveHistory;
                var platform = LiveLinkView.PlatformOf(history?.StreamUrl);
                var platformLabel = LiveLinkView.LabelOf(platform);
                var historyPkid = history?.Pkid ?? 0;
                <tr>
                    <td>@video.Name</td>
                    <td><span class="badge @LiveStatusView.Css(video.LiveStatus)">@T[LiveStatusView.Key(video.LiveStatus)]</span></td>
                    <td>@(video.ChannelName ?? "N/A")</td>
                    <td>
                        @if (platform is not null)
                        {
                            <span class="platform"><span class="platform-mark @LiveLinkView.ClassOf(platform)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@LiveLinkView.MarkupOf(platform)" /></svg></span>@platformLabel</span>
                        }
                        else
                        {
                            <span class="muted" title="@history?.StreamUrl">–</span>
                        }
                    </td>
                    <td class="path"><div class="truncate" title="@video.VideoPath">@video.VideoPath</div></td>
                    <td class="nowrap">@LiveStatusView.Date(history?.LocalDateTimeStartLive, "dd-MM-yyyy HH:mm:ss")</td>
                    <td>@video.Message</td>
                    <td class="nowrap">
                        @if (historyPkid > 0)
                        {
                            <form method="post" asp-page-handler="Delete" asp-route-id="@historyPkid" class="inline" data-confirm="@T["deleteLiveHistoryConfirm"]">
                                <button type="submit" class="btn subtle icon-only danger" title="@T["deleteLiveHistory"]" aria-label="@T["deleteLiveHistory"]"><i class="icon">&#xE74D;</i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    </div>
    <div class="pager-fixed">
        <partial name="_Pager" model="pager" />
    </div>
    </div>
}

<script>
    // The two fields only mean something while the cleanup is on: the toggle shows and hides them,
    // the server draws them the way they were left.
    const autoCleanupEnabled = document.getElementById("autoCleanupEnabled");
    const autoCleanupFields = document.getElementById("autoCleanupFields");

    if (autoCleanupEnabled && autoCleanupFields) {
        autoCleanupEnabled.addEventListener("change", () => {
            autoCleanupFields.style.display = autoCleanupEnabled.checked ? "flex" : "none";
        });
    }
</script>

<style>
    /* The two picks sit on one row: their own margins would push the rest of the toolbar out of
      the header. */
    .auto-cleanup-config .field,
    .auto-cleanup-config .toggle-section {
        margin: 0;
    }
</style>
