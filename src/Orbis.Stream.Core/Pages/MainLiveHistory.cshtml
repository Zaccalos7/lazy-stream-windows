@page "/orbis/mainLiveHistory"
@model MainLiveHistoryModel
@{
    ViewData["Title"] = T["liveHistory"];
    var page = Model.Videos.Page;
    var pager = new PagerModel(page.Number, page.TotalPages, index => Url.Page("/MainLiveHistory", new { p = index })!);
}
@* Storico Live è una pagina a sé: nel menu c'è già la voce, quindi nessun "indietro" né il
   collegamento a Gestione Live nell'intestazione. *@
<div class="page-header">
    <div>
        <h1>@T["liveHistory"]</h1>
    </div>
    <div class="toolbar">
        <div class="toolbar-group">
            <span class="caption">@T["deleteOldLiveHistory"]</span>
            <select id="deleteOldSelector" class="input" aria-label="@T["deleteOldLiveHistory"]">
                <option value="" disabled selected>@T["olderThan3Months"]</option>
                <option value="3">@T["olderThan3Months"]</option>
                <option value="6">@T["olderThan6Months"]</option>
                <option value="12">@T["olderThan1Year"]</option>
                <option value="24">@T["olderThan2Years"]</option>
            </select>
            <button id="deleteOldBtn" class="btn subtle danger" disabled>
                <i class="icon">&#xE74D;</i> @T["deleteOldLiveHistory"]
            </button>
        </div>
    </div>
</div>

@if (Model.Videos.Content.Count == 0)
{
    <div class="card empty"><i class="icon">&#xE81C;</i>@T["noDataPresent"]</div>
}
else
{
    <div class="live-rows-container history-rows-container">
    <div class="table-wrap-scrollable">
    <div class="table-wrap">
        <table class="list roomy">
            <thead>
            <tr>
                <th>@T["title"]</th>
                <th>@T["liveStatus"]</th>
                <th>@T["channel"]</th>
                <th>@T["platform"]</th>
                <th>@T["path"]</th>
                <th>@T["data"]</th>
                <th>@T["outcome"]</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var video in Model.Videos.Content)
            {
                var history = video.VideoLiveHistory;
                var platform = LiveLinkView.PlatformOf(history?.StreamUrl);
                var platformLabel = LiveLinkView.LabelOf(platform);
                var historyPkid = history?.Pkid ?? 0;
                <tr>
                    <td>@video.Name</td>
                    <td><span class="badge @LiveStatusView.Css(video.LiveStatus)">@T[LiveStatusView.Key(video.LiveStatus)]</span></td>
                    <td>@(video.ChannelName ?? "N/A")</td>
                    <td>
                        @if (platform is not null)
                        {
                            <span class="platform"><span class="platform-mark @LiveLinkView.ClassOf(platform)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@LiveLinkView.MarkupOf(platform)" /></svg></span>@platformLabel</span>
                        }
                        else
                        {
                            <span class="muted" title="@history?.StreamUrl">–</span>
                        }
                    </td>
                    <td class="path"><div class="truncate" title="@video.VideoPath">@video.VideoPath</div></td>
                    <td class="nowrap">@LiveStatusView.Date(history?.LocalDateTimeStartLive, "dd-MM-yyyy HH:mm:ss")</td>
                    <td>@video.Message</td>
                    <td class="nowrap">
                        @if (historyPkid > 0)
                        {
                            <form method="post" action="/video/live-history/@historyPkid" class="inline" onsubmit="return confirmDelete(this, '@T["deleteLiveHistoryConfirm"]')">
                                <button type="submit" class="btn subtle icon-only danger" title="@T["deleteLiveHistory"]" aria-label="@T["deleteLiveHistory"]"><i class="icon">&#xE74D;</i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    </div>
    <div class="pager-fixed">
        <partial name="_Pager" model="pager" />
    </div>
    </div>
}

<script>
    // Bulk delete old live histories
    const selector = document.getElementById("deleteOldSelector");
    const btn = document.getElementById("deleteOldBtn");
    if (selector && btn) {
        selector.addEventListener("change", () => {
            btn.disabled = !selector.value;
        });
        btn.addEventListener("click", async () => {
            const months = selector.value;
            if (!months) return;
            const confirmMsg = "@T["deleteOldLiveHistoryConfirm"]".replace("{0}", months);
            if (!confirm(confirmMsg)) return;
            btn.disabled = true;
            try {
                const resp = await fetch(`/video/live-history/older-than/${months}`, { method: "DELETE" });
                if (resp.ok) {
                    location.reload();
                } else {
                    alert("Error: " + await resp.text());
                }
            } catch (e) {
                alert("Error: " + e);
            } finally {
                btn.disabled = false;
            }
        });
    }

    function confirmDelete(form, msg) {
        return confirm(msg);
    }
</script>
