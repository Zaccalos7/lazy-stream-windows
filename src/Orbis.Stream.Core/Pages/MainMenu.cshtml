@page "/orbis/mainMenu"
@{
    ViewData["Title"] = T["dashboard"];
}
@section Styles {
    
    <link rel="stylesheet" href="/css/dashboard.css" />
}
<div class="page-header">
    <div>
        <h1>@T["dashboard"]</h1>
        <p class="subtitle">@T["dashboardDescription"]</p>
    </div>
    @* The weasel, given the room it deserves: a banner across the width of the page rather than a
       button in the middle of it, so it is read as the banner it is. *@
    <a class="coffee-banner" href="https://buymeacoffee.com/zaccalos" target="_blank" rel="noopener noreferrer">
        <span class="coffee-banner-weasel" aria-hidden="true">🦦</span>
        <span class="coffee-banner-text">@T["payMeAWeasel"]</span>
        <span class="coffee-banner-cup" aria-hidden="true">☕</span>
    </a>
</div>


<h3 class="section">@T["dashboardSectionLive"]</h3>
<div class="grid">
    <a class="tile" href="/orbis/mainLive">
        <i class="icon">&#xE714;</i>
        <div><h3>@T["liveManagement"]</h3><p>@T["liveManagementDescription"]</p></div>
    </a>
    <a class="tile" href="/orbis/mainPreview">
        <i class="icon">&#xE7F4;</i>
        <div><h3>@T["preview"]</h3><p>@T["previewDescription"]</p></div>
    </a>
    <a class="tile" href="/orbis/mainLayoutList">
        <i class="icon">&#xE8B9;</i>
        <div><h3>@T["layouts"]</h3><p>@T["layoutsDescription"]</p></div>
    </a>
    <a class="tile" href="/orbis/mainLiveHistory">
        <i class="icon">&#xE81C;</i>
        <div><h3>@T["liveHistory"]</h3><p>@T["liveHistoryDescription"]</p></div>
    </a>
</div>

<div class="section">
    <h3 class="section">@T["dashboardSectionSettings"]</h3>
    <div class="grid">
        <a class="tile" href="/orbis/mainVideoSetting">
            <i class="icon">&#xE714;</i>
            <div><h3>@T["videoAndAudio"]</h3><p>@T["additionalVideoOptionsDescription"]</p></div>
        </a>
        <a class="tile" href="/orbis/mainChannelSetting">
            <i class="icon">&#xE93E;</i>
            <div><h3>@T["channelSettings"]</h3><p>@T["channelSettingsDescription"]</p></div>
        </a>
    </div>
</div>

<div class="section">
    <h3 class="section">@T["dashboardSectionSystem"]</h3>
    <div class="grid">
        <a class="tile" href="/orbis/mainTaskManager">
            <i class="icon">&#xE9D9;</i>
            <div><h3>@T["taskManager"]</h3><p>@T["taskManagerDescription"]</p></div>
        </a>
    </div>
</div>

