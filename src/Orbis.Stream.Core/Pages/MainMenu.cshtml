@page "/orbis/mainMenu"
@{
    ViewData["Title"] = T["dashboard"];
}
@section Styles {
    
    <link rel="stylesheet" href="/css/dashboard.css" />
}
<div class="page-header">
    <div>
        <h1>@T["dashboard"]</h1>
        <p class="subtitle">@T["dashboardDescription"]</p>
    </div>
</div>

<div class="grid">
    <a class="tile" href="/orbis/mainLiveMenu">
        <i class="icon">&#xE714;</i>
        <div><h3>Live</h3><p>@T["liveManagementDescription"]</p></div>
    </a>
    <a class="tile" href="/orbis/mainTaskManager">
        <i class="icon">&#xE9D9;</i>
        <div><h3>@T["taskManager"]</h3><p>@T["taskManagerDescription"]</p></div>
    </a>
    <a class="tile" href="/orbis/mainSetting">
        <i class="icon">&#xE713;</i>
        <div><h3>@T["settings"]</h3><p>@T["settingsDescription"]</p></div>
    </a>
</div>

<div class="page-footer">
    @* The weasel, given the room it deserves: a banner across the width of the page rather than a
       button in the middle of it, so it is read as the banner it is. *@
    <a class="coffee-banner" href="https://buymeacoffee.com/zaccalos" target="_blank" rel="noopener noreferrer">
        <span class="coffee-banner-weasel" aria-hidden="true">🦦</span>
        <span class="coffee-banner-text">@T["payMeAWeasel"]</span>
        <span class="coffee-banner-cup" aria-hidden="true">☕</span>
    </a>
</div>
