@page "/orbis/mainTaskManager"
@model MainTaskManagerModel
@{
    ViewData["Title"] = T["taskManager"];
}
@section Styles {
    @* The rings and the meters that read the machine live only here. *@
    <link rel="stylesheet" href="/css/meters.css" />
}
<div class="page-header">
    <div>
        <h1>@T["taskManager"]</h1>
        <p class="subtitle">@T["taskManagerDescription"]</p>
    </div>
</div>

@* The meters are painted by the push channel: the server samples them and sends the values, so the
   page asks for nothing. They stay in their loading until the first sample arrives. *@
<div data-stats data-state="loading">
    <partial name="_Stats" model="Model" />
</div>

<div class="page-header" style="margin-top: 2rem; padding: 10px 24px; min-height: unset;">
    <div>
        <h3>@T["appUsage"]</h3>
    </div>
</div>

<div data-stats data-state="loading">
    <partial name="_AppStats" model="Model" />
</div>

@* What the machine is needs WMI, which can take a second the first time. It is asked for on its
   own, into a panel that only shows a loading when the answer is slow enough to be noticed. *@
<div class="card section" data-load="@Url.Page("/MainTaskManager", "Facts")" data-delay="400">
    <h3><i class="icon">&#xE9D9;</i>&nbsp; @T["systemInfo"]</h3>
    <p class="caption" data-while="loading">
        <span class="spinner" aria-hidden="true"></span>&nbsp; @T["loading"]
    </p>
    <p class="caption" data-while="failed">
        @T["noDataPresent"]
        <button class="btn" type="button" data-reload>@T["retry"]</button>
    </p>
</div>
