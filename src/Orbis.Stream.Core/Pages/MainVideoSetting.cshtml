@page "/orbis/mainVideoSetting"
@model MainVideoSettingModel
@{
    ViewData["Title"] = T["videoAndAudioSettings"];
}
<div class="page-header">
    <div>
        <h1>@T["videoAndAudioSettings"]</h1>
        <p class="subtitle"><a href="/orbis/mainSetting">@T["settings"]</a> › @T["videoAndAudio"]</p>
    </div>
    <a class="btn accent" href="?edit=new"><i class="icon">&#xE710;</i>@T["addButton"]</a>
</div>

@if (Model.Settings.Count == 0)
{
    <div class="card empty"><i class="icon">&#xE714;</i>@T["noDataPresent"]</div>
}

@foreach (var setting in Model.Settings)
{
    var active = setting.IsVideoAndAudioSettingActive ?? false;
    var displayTitle = SettingTitleView.Of(setting.Title, T);
    <div class="row-card">
        <i class="icon lead">&#xE714;</i>
        <div class="grow">
            <h3 class="truncate">@displayTitle</h3>
            <div class="caption truncate">
                @T["videoCodecName"]: @(setting.VideoCodecName ?? "N/A") ·
                @T["bitrate"]: @VideoSettingForm.FormatBitrate(setting.VideoBitrate) ·
                @T["audioBitrate"]: @VideoSettingForm.FormatBitrate(setting.AudioSettingRecord?.AudioBitrate)
            </div>
        </div>
        <div class="actions">
            @if (active)
            {
                <span class="badge ended">@T["activeButton"]</span>
            }
            <a class="btn subtle icon-only" href="?edit=@setting.Id" title="@T["editModalTitle"]" aria-label="@T["editModalTitle"]"><i class="icon">&#xE70F;</i></a>
            <form method="post" asp-page-handler="Duplicate" asp-route-id="@setting.Id">
                <button class="btn subtle icon-only" title="@T["duplicate"]" aria-label="@T["duplicate"]"><i class="icon">&#xE8C8;</i></button>
            </form>
            <form method="post" asp-page-handler="Toggle" asp-route-id="@setting.Id">
                <label class="toggle" title="@(active ? T["deactivateButton"] : T["activeButton"])">
                    <input type="checkbox" checked="@active" onchange="this.form.requestSubmit()" aria-label="@T["activeButton"]" />
                </label>
            </form>
        </div>
    </div>
}

@if (Model.Form is not null)
{
    <dialog class="dialog settings" data-open>
        <form method="post" asp-page-handler="Save">
            <div class="dialog-body">
                <h2>@(Model.IsNew ? T["addNewAudioVideoConfiguration"] : T["editModalTitle"])</h2>
                @* The templates, each in the colour and with the mark of the platform it is made for. *@
                <div class="toolbar preset-bar">
                    <span class="muted">@T["clickButtonToLoadVideoSettings"]</span>
                    <a class="btn brand twitch" href="?edit=@(Model.Form.Id?.ToString() ?? "new")&preset=Twitch">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@LiveLinkView.MarkupOf("twitch")" /></svg>Twitch
                    </a>
                    <a class="btn brand youtube" href="?edit=@(Model.Form.Id?.ToString() ?? "new")&preset=Youtube">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@LiveLinkView.MarkupOf("youtube")" /></svg>YouTube
                    </a>
                    <a class="btn brand kick" href="?edit=@(Model.Form.Id?.ToString() ?? "new")&preset=Kick">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@LiveLinkView.MarkupOf("kick")" /></svg>Kick
                    </a>
                    <a class="btn brand facebook" href="?edit=@(Model.Form.Id?.ToString() ?? "new")&preset=@Uri.EscapeDataString("Facebook Gaming")">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@LiveLinkView.MarkupOf("facebook")" /></svg>Facebook Gaming
                    </a>
                </div>
                <partial name="_VideoSettingFields" for="Form" />
            </div>
            <div class="dialog-footer">
                @if (!Model.IsNew)
                {
                    <button class="btn subtle danger" type="submit" asp-page-handler="Delete" asp-route-id="@Model.Form.Id" data-confirm="@T["deleteConfiguration"]" formnovalidate style="margin-right: auto;"><i class="icon">&#xE74D;</i>@T["delete"]</button>
                }
                <button class="btn accent">@T["save"]</button>
                <a class="btn" href="/orbis/mainVideoSetting">@T["cancel"]</a>
            </div>
        </form>
    </dialog>
}
