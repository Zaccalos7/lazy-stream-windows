@{
    var path = Context.Request.Path.Value ?? string.Empty;
    string? Current(params string[] pages) =>
        pages.Any(page => path.Equals("/orbis/" + page, StringComparison.OrdinalIgnoreCase) || path.StartsWith("/orbis/" + page + "/", StringComparison.OrdinalIgnoreCase)) ? "page" : null;
    var notice = ViewContext.ViewData.Model as OrbisPageModel;
}
<!DOCTYPE html>
<html lang="@T.Language" dir="@(UiText.IsRightToLeft(T.Language) ? "rtl" : "ltr")" data-initializing="@T["initializing"]" data-app-version="@AppInfo.Current.Version" data-update-available-dialog-text="@T["updateAvailableDialogText"]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} – Orbis Stream" : "Orbis Stream")</title>
    <link rel="icon" href="/favicon.ico" />
    
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/controls.css" />
    <link rel="stylesheet" href="/css/surfaces.css" />
    <link rel="stylesheet" href="/css/overlays.css" />
    <link rel="stylesheet" href="/css/feedback.css" />
    @await RenderSectionAsync("Styles", required: false)
    <script>
        (function() {
            var theme = localStorage.getItem('orbis-theme') || 'dark';
            if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
            }
            if (localStorage.getItem('orbis-sidebar') === 'closed') {
                document.documentElement.classList.add('sidebar-closed');
            }
        })();
    </script>
    <script src="/js/site.js" defer></script>
</head>
<body>
<div class="shell">
    <nav class="nav" id="orbis-sidebar" aria-label="Orbis Stream">
        <div class="nav-title">
            <button type="button" class="btn subtle icon-only" id="sidebar-toggle" title="Toggle Sidebar" aria-label="Toggle Sidebar" aria-controls="orbis-sidebar" aria-expanded="true"><i class="icon">&#xE700;</i></button>
            <img src="/favicon.ico" alt="" />
            <span>Orbis Stream</span>
            <button type="button" class="update-bell" id="update-bell" title="@T["updateAvailable"]" aria-label="@T["updateAvailable"]" hidden>
                <i class="icon" aria-hidden="true">&#xEA8F;</i>
            </button>
        </div>
        <a href="/orbis/mainMenu" aria-current="@Current("mainMenu")"><i class="icon">&#xE80F;</i><span>@T["dashboard"]</span></a>
        <a href="/orbis/mainLiveMenu" aria-current="@Current("mainLiveMenu", "mainLive", "countdown", "mainLiveHistory")"><i class="icon">&#xE714;</i><span>Live</span></a>
        <a href="/orbis/mainPreview" aria-current="@Current("mainPreview")"><i class="icon">&#xE7F4;</i><span>@T["livePreviewTitle"]</span></a>
        <a href="/orbis/mainLayoutList" aria-current="@Current("mainLayoutList", "mainLayout")"><i class="icon">&#xE8B9;</i><span>@T["layouts"]</span></a>
        <a href="/orbis/mainTaskManager" aria-current="@Current("mainTaskManager")"><i class="icon">&#xE9D9;</i><span>@T["taskManager"]</span></a>
        <a href="/orbis/mainSetting" aria-current="@Current("mainSetting", "mainVideoSetting", "mainChannelSetting")"><i class="icon">&#xE713;</i><span>@T["settings"]</span></a>
        <a href="/orbis/mainManual" aria-current="@Current("mainManual")"><i class="icon">&#xE897;</i><span>@T["manualTitle"]</span></a>
        <div class="nav-spacer"></div>
        
        <div class="segmented-control" role="radiogroup" aria-label="Theme">
            <button type="button" class="segment" data-theme-set="light" title="Light" aria-label="Light Theme"><i class="icon">&#xE706;</i></button>
            <button type="button" class="segment" data-theme-set="dark" title="Dark" aria-label="Dark Theme"><i class="icon">&#xE708;</i></button>
        </div>

        <details class="lang-picker">
            <summary class="lang-current" title="Language" aria-label="Language">
                @{
                    // The language of the page is always one of the ones offered: T.Language already
                    // falls back to English when the cookie asks for something no bundle answers.
                    var current = UiText.Languages.First(l => l.Code == T.Language);
                }
                <img src="~/flags/@current.Flag" alt="" width="22" height="15">
                <span>@current.Name</span>
                <i class="icon" aria-hidden="true">&#xE70D;</i>
            </summary>
            <ul class="lang-menu">
                @foreach (var language in UiText.Languages)
                {
                    <li>
                        <a href="/orbis/lang/@language.Code" lang="@language.Code" hreflang="@language.Code"
                           aria-current="@(language.Code == T.Language ? "true" : null)">
                            <img src="~/flags/@language.Flag" alt="" width="22" height="15">
                            <span>@language.Name</span>
                        </a>
                    </li>
                }
            </ul>
        </details>
        
        <button type="button" class="nav-about" id="about-button" data-open-about title="@T["about"]" aria-label="@T["about"]" aria-haspopup="dialog">
            <i class="icon" aria-hidden="true">&#xE946;</i>
            <span class="nav-about-text">
                <strong>@AppInfo.Current.NameAndVersion</strong>
                @if (AppInfo.Current.Author is { Length: > 0 } author)
                {
                    <small>@T["aboutAuthor"] @author</small>
                }
            </span>
        </button>
    </nav>
    <main class="content">
        <div class="page">
            @if (notice?.Notice is { } kind && !string.IsNullOrEmpty(notice.NoticeText))
            {
                var (css, glyph, heading) = kind switch
                {
                    NoticeKind.Success => ("success", "\uE73E", T["success"]),
                    NoticeKind.Warning => ("warning", "\uE7BA", T["warning"]),
                    _ => ("error", "\uEA39", T["error"])
                };
                <div class="infobar @css" role="status">
                    <i class="icon">@glyph</i>
                    <p><strong>@heading</strong>&nbsp; @notice.NoticeText</p>
                </div>
            }
            @RenderBody()
        </div>
    </main>
</div>

<dialog class="dialog" id="update-dialog">
    <form method="dialog">
        <div class="dialog-body"><h2 id="update-dialog-text"></h2></div>
        <div class="dialog-footer">
            <button class="btn accent" value="ok">@T["confirm"]</button>
            <button class="btn" value="cancel">@T["cancel"]</button>
        </div>
    </form>
</dialog>

<dialog class="dialog" id="confirm-dialog">
    <form method="dialog">
        <div class="dialog-body"><h2 data-text></h2></div>
        <div class="dialog-footer">
            <button class="btn accent" value="ok">@T["confirm"]</button>
            <button class="btn" value="cancel">@T["cancel"]</button>
        </div>
    </form>
</dialog>

@* The version and who wrote the application, said as big as the window allows: the foot of the
   side bar carries the same two facts in one line each, and this is where they are read. *@
<dialog class="dialog about" id="about-dialog">
    <form method="dialog">
        <div class="dialog-body about-body">
            <img src="/favicon.ico" alt="" class="about-mark" width="72" height="72" />
            <h2 class="about-name">@AppInfo.Current.Name</h2>
            <dl class="about-facts">
                <div class="about-fact">
                    <dt>@T["aboutVersion"]</dt>
                    <dd class="about-value" data-about-version>@AppInfo.Current.Version</dd>
                </div>
                @if (AppInfo.Current.Author is { Length: > 0 } author)
                {
                    <div class="about-fact">
                        <dt>@T["aboutAuthor"]</dt>
                        <dd class="about-value" data-about-author>@author</dd>
                    </div>
                }
            </dl>
        </div>
        <div class="dialog-footer">
            <button class="btn accent" value="ok">@T["close"]</button>
        </div>
    </form>
</dialog>
</body>
</html>
