@model VideoSettingForm
@using Orbis.Stream.Core.Services
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="IsActive" />

<label class="field">
    <span>@T["videoSettingTitle"]</span>
    <input class="input" asp-for="Title" placeholder="@T["titlePlaceholder"]" required />
</label>

<h3 class="section">@T["video"]</h3>
<div class="form-grid">
    <label class="field">
        <span>@T["codec"]</span>
        <select class="input" asp-for="VideoCodec" asp-items="VideoSettingForm.Items(FfmpegCodecCatalog.VideoCodecs)" required>
            <option value="">@T["selectACodec"]</option>
        </select>
    </label>
    <label class="field">
        <span>@T["videoCodecName"]</span>
        <select class="input" asp-for="VideoCodecName" asp-items="VideoSettingForm.CodecNameItems()" required>
            <option value="">@T["selectVideoCodecName"]</option>
        </select>
    </label>
    <label class="field">
        <span>@T["encoderQuality"]<i class="icon field-help" title="@T["encoderQualityHelp"]" aria-label="@T["encoderQualityHelp"]">&#xE946;</i></span>
        <select class="input" asp-for="Quality" title="@T["encoderQualityHelp"]">
            <option value="Auto">@T["encoderQualityAuto"]</option>
            <option value="Light">@T["encoderQualityLight"]</option>
            <option value="Balanced">@T["encoderQualityBalanced"]</option>
            <option value="High">@T["encoderQualityHigh"]</option>
        </select>
        <small>@T["encoderQualityHint"]</small>
    </label>
    <label class="field">
        <span>@T["pixelFormat"]</span>
        <select class="input" asp-for="PixelFormat" asp-items="VideoSettingForm.Items(FfmpegCodecCatalog.PixelFormats)" required>
            <option value="">@T["selectAPixelFormat"]</option>
        </select>
    </label>
    <label class="field">
        <span>@T["videoFormat"]</span>
        <select class="input" asp-for="VideoFormat" asp-items="VideoSettingForm.FormatItems()" required>
            <option value="">@T["selectFormat"]</option>
        </select>
    </label>
    @* A bitrate is kept in bits per second and read in Mbit/s: the box speaks the friendly unit,
       the hidden input above it posts the exact count, and site.js keeps the two in step. The
       ceiling on the box is what says which unit a bare number is read in (site.js), so the two
       fields have to carry theirs too: Mbit/s for the video, kbit/s for the audio. *@
    <label class="field">
        <span>@T["bitrate"]</span>
        <span class="bitrate" data-bitrate-box>
            <input type="hidden" asp-for="VideoBitrate" />
            <input class="input" data-bitrate data-bitrate-max="@LivePreviewService.MaximumVideoBitrate"
                   data-bitrate-invalid="@T["invalidParameter"]" type="text"
                   inputmode="decimal" autocomplete="off" placeholder="@T["exampleBitrate"]"
                   value="@VideoSettingForm.WriteBitrate(Model.VideoBitrate)" required />
            <span class="bitrate-unit" data-bitrate-unit aria-hidden="true"></span>
        </span>
        <small class="bitrate-hint" data-bitrate-hint></small>
    </label>
    <label class="field">
        <span>@T["gopSize"]</span>
        <input class="input" asp-for="GopSize" type="number" min="1" step="1" placeholder="@T["gopSizeRecommendation"]" required />
    </label>
    <label class="field">
        <span>@T["width"]</span>
        <input class="input" asp-for="VideoWidth" type="number" min="2" step="2" placeholder="@T["keepSource"]" />
    </label>
    <label class="field">
        <span>@T["height"]</span>
        <input class="input" asp-for="VideoHeight" type="number" min="2" step="2" placeholder="@T["keepSource"]" />
    </label>
    <label class="field">
        <span>@T["frameRate"]</span>
        <input class="input" asp-for="FrameRate" type="number" min="1" max="240" step="0.001" placeholder="@T["keepSource"]" />
        <small>fps</small>
    </label>
</div>

@* Audio and the options of the encoder share one row: each is two fields, and side by side they
   let the whole setting fit in the dialog without a scroll. *@
<div class="settings-split">
    <div>
        <h3 class="section">@T["audio"]</h3>
        <div class="form-grid pair">
            <label class="field">
                <span>@T["audioCodec"]</span>
                <select class="input" asp-for="AudioCodec" asp-items="VideoSettingForm.Items(FfmpegCodecCatalog.AudioCodecs)" required>
                    <option value="">@T["selectACodec"]</option>
                </select>
            </label>
            <label class="field">
                <span>@T["audioBitrate"]</span>
                <span class="bitrate" data-bitrate-box>
                    <input type="hidden" asp-for="AudioBitrate" />
                    <input class="input" data-bitrate data-bitrate-max="@LivePreviewService.MaximumAudioBitrate"
                           data-bitrate-invalid="@T["invalidParameter"]" type="text"
                           inputmode="decimal" autocomplete="off" placeholder="@T["exampleAudioBitrate"]"
                           value="@VideoSettingForm.WriteBitrate(Model.AudioBitrate)" required />
                    <span class="bitrate-unit" data-bitrate-unit aria-hidden="true"></span>
                </span>
                <small class="bitrate-hint" data-bitrate-hint></small>
            </label>
        </div>
    </div>

    <div>
        <h3 class="section">@T["additionalVideoOptions"]</h3>
        <div class="form-grid pair">
            <label class="field">
                <span>preset</span>
                <select class="input" asp-for="Preset" asp-items="VideoSettingForm.PresetItems()" data-tuning disabled="@Model.LowLatency" required="@(!Model.LowLatency)">
                    <option value="">–</option>
                </select>
            </label>
            <label class="field">
                <span>tune</span>
                <select class="input" asp-for="Tune" asp-items="VideoSettingForm.TuneItems()" data-tuning disabled="@Model.LowLatency" required="@(!Model.LowLatency)">
                    <option value="">–</option>
                </select>
            </label>
        </div>
        <small class="tuning-hint" data-tuning-hint hidden="@Model.LowLatency"><i class="icon" aria-hidden="true">&#xE7BA;</i>@T["tuningRequired"]</small>
    </div>
</div>

@* Low latency is a decision about the whole live, not one more value: it gets a card of its own,
   with what it does said next to the switch instead of under the grid. Turned off, the preset and
   the tune above become required (VideoSettingForm.IsTuningComplete, and site.js on the page). *@
<label class="option-card">
    <i class="icon option-card-mark" aria-hidden="true">&#xE945;</i>
    <span class="option-card-text">
        <strong>@T["lowLatency"]</strong>
        <small>@T["lowLatencyHelp"]</small>
    </span>
    <span class="toggle"><input asp-for="LowLatency" data-low-latency /></span>
</label>
