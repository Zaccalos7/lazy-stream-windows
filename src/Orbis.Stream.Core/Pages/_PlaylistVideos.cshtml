@model MainLiveModel
@inject Orbis.Stream.Core.Services.YouTubeAirWatch Air

@if (Model.OpenedPlaylist is { } playlist)
{
    <div class="table-wrap">
        <table class="list">
            <thead>
            <tr>
                <th>#</th>
                <th>@T["liveStatus"]</th>
                <th>@T["title"]</th>
                @if (!playlist.IsScene)
                {
                    <th>@T["playlistStoppedAt"]</th>
                    <th></th>
                }
            </tr>
            </thead>
            <tbody>
            @{
                // One playlist is on air at a time: while it is, the start points wait for a stop.
                var playlistLive = playlist.Status == LiveStatus.Live;
            }
            @for (var index = 0; index < playlist.Videos.Count; index++)
            {
                var video = playlist.Videos[index];
                var status = video.LiveStatus;
                var live = status == LiveStatus.Live;
                var current = video.Pkid == playlist.CurrentPkid;
                var position = video.LastTimeStampBeforeStop ?? 0;
                <tr class="@(current ? "is-current" : null)" aria-current="@(current ? "true" : null)">
                    <td class="num">@(index + 1)</td>
                    <td><span class="badge @LiveStatusView.Css(status)">@T[LiveStatusView.Key(status)]</span></td>
                    <td class="path">
                        <div class="truncate"><strong>@video.Name</strong></div>
                        <div class="caption truncate" title="@video.VideoPath">@video.VideoPath</div>
                    </td>
                    
                    @if (!playlist.IsScene)
                    {
                        <td class="num">@(position > 0 && status != LiveStatus.Ended ? TimeSpan.FromMilliseconds(position).ToString(@"hh\:mm\:ss") : "–")</td>
                        <td>
                            <div class="actions">
                                @{
                                    var history = playlist.History;
                                    var platform = history.PlatformStreamName;
                                    var knownPlatform = LiveLinkView.PlatformOf(history.StreamUrl);
                                    var liveUrl = live ? LiveLinkView.UrlOf(history.StreamUrl, history.UserName, platform, Air.OnAirVideoOf(history.Pkid)) : null;
                                }

                                @if (knownPlatform != null && liveUrl != null)
                                {
                                    var markClass = "platform-mark " + LiveLinkView.ClassOf(knownPlatform);
                                    var platformName = LiveLinkView.LabelOf(knownPlatform) ?? knownPlatform;
                                    <a href="@liveUrl" class="btn subtle icon-only" target="_blank" rel="noopener noreferrer" title="@platformName" aria-label="@platformName">
                                        <span class="@markClass"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@LiveLinkView.MarkupOf(knownPlatform)" /></svg></span>
                                    </a>
                                }

                                @if (live)
                                {
                                    <a class="btn subtle icon-only" href="/orbis/mainPreview?live=@video.Pkid" title="@T["preview"]" aria-label="@T["preview"]">
                                        <i class="icon">&#xE7F4;</i>
                                    </a>
                                }

                                <button type="button" class="btn subtle icon-only" disabled="@(!live)" title="@T["playSpot"]" aria-label="@T["playSpot"]"
                                        onclick="document.querySelector('#spot-dialog input[name=videoKey]').value = '@video.Pkid'; document.getElementById('spot-dialog').showModal();"
                                        commandfor="spot-dialog" command="show-modal">
                                    <partial name="_SpotIcon" />
                                </button>
                                <form method="post" asp-page="/MainLive" asp-page-handler="Stop" asp-all-route-data="Model.DetailsRowRoute(video.Pkid)" data-confirm="@T["stopLive"]">
                                    <button class="btn subtle icon-only danger" disabled="@(!live)" title="@T["stopLiveIconLabel"]" aria-label="@T["stopLiveIconLabel"]"><i class="icon">&#xE71A;</i></button>
                                </form>
                                <form method="post" asp-page="/MainLive" asp-page-handler="ReplayFrom" asp-all-route-data="Model.DetailsRowRoute(video.Pkid)" data-confirm="@string.Format(T["playlistStartFromConfirm"], index + 1)">
                                    <button class="btn subtle icon-only success" disabled="@playlistLive" title="@T["playlistStartFrom"]" aria-label="@T["playlistStartFrom"]"><i class="icon">&#xE768;</i></button>
                                </form>
                                <form method="post" asp-page="/MainLive" asp-page-handler="Restart" asp-all-route-data="Model.DetailsRowRoute(video.Pkid)" data-confirm="@T["restartLiveAlert"]">
                                    <button class="btn subtle icon-only caution" title="@T["restartLiveIconLabel"]" aria-label="@T["restartLiveIconLabel"]"><i class="icon">&#xE72C;</i></button>
                                </form>
                                <form method="post" asp-page="/MainLive" asp-page-handler="Delete" asp-all-route-data="Model.DetailsRowRoute(video.Pkid)" data-confirm="@T["deleteLiveRowConfirm"]">
                                    <button class="btn subtle icon-only danger" disabled="@live" title="@T["deleteLiveRow"]" aria-label="@T["deleteLiveRow"]"><i class="icon">&#xE74D;</i></button>
                                </form>
                                <span class="spinner" data-while="busy" title="@T["loading"]"></span>
                            </div>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card empty"><i class="icon">&#xE714;</i>@T["noDataPresent"]</div>
}
