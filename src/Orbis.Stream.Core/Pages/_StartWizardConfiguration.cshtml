@model MainLiveModel

@* The second step of both wizards: where the live goes, and for the playlist, what is streamed. *@
<h3 class="section">@T["wizardStep2Title"]</h3>
@if (Model.ActiveConfigurations.Count == 0)
{
    <div class="infobar warning section">
        <i class="icon">&#xE7BA;</i>
        <p><strong>@T["noActiveStreamingConfiguration"]</strong><br />@T["wizardNoActiveConfigurationsMessage"]</p>
        <a class="btn" href="/orbis/mainChannelSetting">@T["activeConfigurationLabel"]</a>
    </div>
}
else
{
    <div class="choice-list section" style="margin-top: 8px;">
        @foreach (var configuration in Model.ActiveConfigurations)
        {
            <label class="choice">
                <input type="radio" name="configurationId" value="@configuration.Id" required />
                <span class="grow">
                    <strong>@configuration.ChannelName</strong> · @(MainChannelSettingModel.ChoiceOf(configuration.PlatformStreamName, configuration.StreamUrl)?.Label ?? configuration.PlatformStreamName)
                    <span class="caption" style="display: block;">@configuration.StreamUrl</span>
                    @if (!string.IsNullOrWhiteSpace(configuration.Description))
                    {
                        <span class="caption" style="display: block;">@configuration.Description</span>
                    }
                </span>
            </label>
        }
    </div>
}