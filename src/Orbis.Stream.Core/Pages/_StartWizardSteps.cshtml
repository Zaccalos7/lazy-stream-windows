@model MainLiveModel

<h3>@T["wizardStep1Title"]</h3>
@if (Model.ActiveSettings.Count == 0)
{
    <div class="infobar warning section">
        <i class="icon">&#xE7BA;</i>
        <p><strong>@T["noActiveSetting"]</strong><br />@T["wizardNoActiveSettingsMessage"]</p>
        <a class="btn" href="/orbis/mainVideoSetting">@T["activateVideoAudioSettings"]</a>
    </div>
}
else
{
    <div class="choice-list section" style="margin-top: 8px;">
        @foreach (var setting in Model.ActiveSettings)
        {
            var displayTitle = string.IsNullOrWhiteSpace(setting.Title)
                ? T["untitled"]
                : (setting.Title == "Default Low Twitch" ? T["defaultLowTwitch"]
                   : setting.Title == "Default Low YouTube" ? T["defaultLowYouTube"]
                   : setting.Title);
            <label class="choice">
                <input type="radio" name="settingId" value="@setting.Id" required />
                <span class="grow">
                    <strong>@displayTitle</strong>
                    @if (setting.IsDefaultConfiguration == true || (!string.IsNullOrEmpty(setting.DefaultPlatformConfiguration) && setting.Title == "Default Low " + setting.DefaultPlatformConfiguration))
                    {
                        <span class="badge">@setting.DefaultPlatformConfiguration</span>
                    }
                    <span class="caption" style="display: block;">
                        @setting.VideoCodecName · @VideoSettingForm.FormatBitrate(setting.VideoBitrate) ·
                        @setting.VideoFormat?.ToUpperInvariant() · GOP @(setting.GopSize?.ToString() ?? "–") ·
                        @T["audioBitrate"] @VideoSettingForm.FormatBitrate(setting.AudioSettingRecord?.AudioBitrate)
                    </span>
                </span>
            </label>
        }
    </div>
}

<h3 class="section">@T["wizardStep2Title"]</h3>
@if (Model.ActiveConfigurations.Count == 0)
{
    <div class="infobar warning section">
        <i class="icon">&#xE7BA;</i>
        <p><strong>@T["noActiveStreamingConfiguration"]</strong><br />@T["wizardNoActiveConfigurationsMessage"]</p>
        <a class="btn" href="/orbis/mainChannelSetting">@T["activeConfigurationLabel"]</a>
    </div>
}
else
{
    <div class="choice-list" style="margin-top: 8px;">
        @foreach (var configuration in Model.ActiveConfigurations)
        {
            <label class="choice">
                <input type="radio" name="configurationId" value="@configuration.Id" required />
                <span class="grow">
                    <strong>@configuration.ChannelName</strong> · @configuration.PlatformStreamName
                    <span class="caption" style="display: block;">@configuration.StreamUrl</span>
                    @if (!string.IsNullOrWhiteSpace(configuration.Description))
                    {
                        <span class="caption" style="display: block;">@configuration.Description</span>
                    }
                </span>
            </label>
        }
    </div>
}
