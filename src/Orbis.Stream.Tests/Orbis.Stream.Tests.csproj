<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Orbis.Stream.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orbis.Stream.Core\Orbis.Stream.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    
    <None Include="..\Orbis.Stream.App\wwwroot\flags\*.svg" Link="flags\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The stylesheets the shell ships, so StyleSheetTests reads the sheets the pages really link
         instead of an empty folder: it compares the links of a page with what is on disk. -->
    <None Include="..\Orbis.Stream.App\wwwroot\css\*.css" Link="css\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
